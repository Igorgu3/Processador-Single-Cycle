----------------------------------------------------------------------------------
-- src_top   (VHDL translation of src_top.v)
--
-- MIPS single-cycle control: main_decoder generates ALUop, alu_decoder turns
-- ALUop + funct into ALUControl.
--
-- One module in Verilog  ->  one entity + one architecture in VHDL.
-- The Verilog "module src_top" ports map 1:1 onto the entity port list.
----------------------------------------------------------------------------------
library ieee;
use ieee.std_logic_1164.all;
 
entity src_top is
    port (
        Opcode : in  std_logic_vector(5 downto 0);
        funct : in  std_logic_vector(5 downto 0);
        ALUop : out std_logic_vector(1 downto 0);
        MemtoReg : out std_logic;
        MemWrite : out std_logic;
        Branch  : out std_logic;
        ALUControl : out std_logic_vector(2 downto 0);
        ALUSrc : out std_logic;
        RegDst : out std_logic;
        RegWrite : out std_logic
    );
end entity src_top;
 
architecture structural of src_top is
begin
 
    -- main_decoder u_control ( ... )
    u_control : entity work.main_decoder
        port map (
            Opcode   => Opcode,
            ALUop    => ALUop,
            MemtoReg => MemtoReg,
            MemWrite => MemWrite,
            Branch   => Branch,
            ALUSrc   => ALUSrc,
            RegDst   => RegDst,
            RegWrite => RegWrite
        );
 
    -- alu_decoder u_decoder ( .funct(funct), .ALUop(ALUop), .ALUControl(ALUControl) )
    u_decoder : entity work.alu_decoder
        port map (
            funct      => funct,
            ALUop      => ALUop,
            ALUControl => ALUControl
        );
 
end architecture structural;
